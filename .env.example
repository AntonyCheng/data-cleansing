# 复制为 .env 后填入真实值；.env 不提交 git。
# 全部凭证仅 BFF 使用，前端不接触。

# ---- 服务端口 ----
BFF_PORT=8787
WEB_ORIGIN=http://localhost:5173

# ---- 运行模式 ----
# mock = 不调用火山，返回内置样例数据；live = 调用真实 API
CLEANSING_MODE=mock

# ---- 数据库（登录 + 工作区持久化）----
# 本地不用 Docker 时，指向你自己起的 Postgres；docker-compose 会用 POSTGRES_PASSWORD 自动拼出 DATABASE_URL 覆盖这里
DATABASE_URL=postgres://postgres:postgres@localhost:5432/data_cleansing
POSTGRES_PASSWORD=postgres

# ---- 演示用外部数据源（黑龙江省多维度真实数据，供"数据库"连接器现场演示）----
# 与上面应用自己的数据库完全独立；5 张表，见 demo-data/heilongjiang-init.sql
DEMO_DB_PASSWORD=demo12345

# ---- 演示用 API 服务（对俄贸易 / 大庆油田年度序列 + 演示网页，供"API 连接器"和"URL / 网页"来源演示）----
# 见 demo-api/server.mjs；连接器鉴权方式选 API Key、请求头名 X-Api-Key、值填这里配置的密钥
DEMO_API_KEY=hlj-demo-2026

# ---- 部署时自动创建的演示账号（工作区预置演示数据，见 bff/src/seedDemo.ts）----
# 留空则不自动创建；只在账号不存在时创建一次，重新部署/容器重建不会覆盖已有账号或数据
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_NAME=演示账号

# ---- 登录 Token 签名密钥 ----
# 生产环境务必换成随机长字符串（例如 openssl rand -hex 32），泄露等于任何人都能伪造登录态
JWT_SECRET=dev-secret-change-me

# ---- 数据连接器凭证加密密钥（数据库密码 / API Token）----
# 必须是 32 字节十六进制（openssl rand -hex 32）；不设置的话，创建/使用数据库或 API 连接器会报错
CONNECTOR_ENCRYPTION_KEY=

# ---- 火山引擎 对象存储 TOS ----
VOLC_TOS_REGION=cn-beijing
VOLC_TOS_ENDPOINT=tos-cn-beijing.volces.com
VOLC_TOS_BUCKET=
VOLC_TOS_ACCESS_KEY=
VOLC_TOS_SECRET_KEY=

# ---- 火山引擎 文字识别 OCR / 视觉（AK/SK 签名，走 visual.volcengineapi.com）----
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_OCR_REGION=cn-north-1

# ---- 火山引擎 豆包语音（新版控制台 console.volcengine.com/speech/new）----
# 新版 2.0 模型用 API Key 鉴权（左侧「API Key」页），走请求头 X-Api-Key
VOLC_SPEECH_API_KEY=
# APP ID：API Key 页右上角，部分接口需要（X-Api-App-Key）
VOLC_SPEECH_APP_ID=
# Resource-Id：文档固定值。豆包录音文件识别模型 2.0 = volc.seedasr.auc
VOLC_SPEECH_RESOURCE_ID_AUC=volc.seedasr.auc
VOLC_SPEECH_RESOURCE_ID_STREAM=volc.bigasr.sauc.duration

# ---- 火山方舟 Ark（豆包大模型 / 视觉理解）----
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID 以火山方舟"开通管理"页显示为准（带日期后缀的也可直接用）
ARK_MODEL_TEXT=doubao-seed-2-1-turbo
ARK_MODEL_VISION=doubao-seed-2-1-turbo
# 图片结构化：doubao-seed-1-6-vision grounding 更准，需单独开通
ARK_MODEL_IMAGE=doubao-seed-1-6-vision
